{
  /*
   * Os scripts de manutenção não estavam em nenhum projeto do `tsc -b` — mesma lacuna que o
   * `tsconfig.api.json` fechou para as funções serverless. Eles importam de `src/` e escrevem
   * em produção com a service role; passar sem conferência de tipo é o pior lugar para isso.
   *
   * Rodam em Node por `npx tsx`, mas importam módulos de `src/` que declaram tipos do
   * navegador (Blob, File, localStorage), então a `lib` inclui DOM.
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["scripts"]
}
