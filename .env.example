# Ambiente: development | production
VITE_APP_ENV=development

# Supabase — frontend (exposto no bundle, seguro)
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase — service role (NÃO expor no frontend, apenas scripts/migrations)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase — personal access token (CLI, Management API)
SUPABASE_ACCESS_TOKEN=your_personal_access_token_here

# Portal público — tenant padrão do agendamento (HUB TREINAVISA SERVIÇOS)
VITE_DEFAULT_TENANT_ID=<uuid-do-tenant-da-hub-treinavisa>

# Supabase Edge Functions - configurar como secrets no Supabase, nao no bundle frontend
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=seu_email_smtp
SMTP_PASS=sua_senha_smtp

# Opcional: webhook do provedor WhatsApp para aviso de relatorio disponivel
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=
